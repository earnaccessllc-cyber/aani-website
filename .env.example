# Supabase (product catalog). Project Settings → API in the Supabase dashboard.
# The publishable/anon key is safe in the browser; RLS limits it to reading the catalog.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe (set in Netlify -> Site configuration -> Environment variables, never commit)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional flat shipping per order, in cents (1500 = $15). Leave unset for complimentary shipping.
SHIPPING_CENTS=
