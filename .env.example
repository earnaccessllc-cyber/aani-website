# Base44 SDK configuration
# These are read by src/lib/app-params.js via import.meta.env at build/runtime.
# Copy this file to .env (or .env.local) and fill in real values.
# .env is gitignored — never commit real values.

# The Base44 app id for this project (found in base44/config.jsonc / Base44 dashboard).
# This is not a secret by itself, but keep it out of version control per project convention.
VITE_BASE44_APP_ID=69d266ece83738de05c57bdb

# The base URL of the Base44-hosted backend for this app, e.g.
# https://your-app-name-xxxxxxxx.base44.app
# Not found in the pulled source — obtain this from the Base44 dashboard for appId
# 69d266ece83738de05c57bdb ("AANI website") and fill it in below.
VITE_BASE44_APP_BASE_URL=

# Optional: pins the Base44 functions version used by base44.functions.invoke().
# Leave blank to use the default/latest version.
VITE_BASE44_FUNCTIONS_VERSION=
